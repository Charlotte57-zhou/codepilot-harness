# Process-level development template. CodePilot does not auto-load this file.
# With no MODEL_PROVIDER, the local server uses the deterministic fake runtime.

MODEL_PROVIDER=anthropic
MODEL_API_KEY=your-provider-key
MODEL_BASE_URL=https://api.anthropic.com
MODEL_NAME=claude-sonnet-4-6
MODEL_TIMEOUT_MS=60000

# Supported real profiles: anthropic, deepseek, moonshot.
# Capability overrides are optional and should match the selected endpoint.
# MODEL_SUPPORTS_IMAGE_INPUT=true
# MODEL_SUPPORTS_PDF_INPUT=true
# MODEL_SUPPORTS_TOOL_CALLING=true
# MODEL_SUPPORTS_REASONING=true
# MODEL_PROMPT_CACHE_MODE=automatic
